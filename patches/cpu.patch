+ * analog multiplier is encoded value + 4. Raw is an 8-bit field, so
+ * the decoded result is <=259 and XTAL(40) * multiplier fits uint32_t.
+ * Existing 360..460 choices agree with linear readback; raw 39 does not. */
+static inline __attribute__((always_inline)) uint32_t clk_ll_cpll_decode_eco1_divider(uint8_t raw)
